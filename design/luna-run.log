-
-/* Bulleted lists with our brand-blue links (underline on hover) */
-.lp-list {
-  list-style: none;
-  margin: 0;
-  padding: 0;
-  line-height: 1.65;
-}
-
-.lp-list li {
-  margin: 7px 0;
-  padding-left: 1.15em;
