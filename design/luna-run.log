+<script>
+(function () {
+  var key = "rk-read";
+  var list = [];
+  try {
+    var stored = JSON.parse(localStorage.getItem(key) || "[]");
+    if (Array.isArray(stored)) list = stored;
+  } catch (e) {}
+  var path = window.location.pathname;
+  var finishButton = document.querySelector("[data-finish-reading]");
+
+  function setReadState(button, isRead) {
+    button.textContent = isRead ? "攻略済み ✓" : "攻略済みにする";
+    button.setAttribute("aria-pressed", String(isRead));
+    button.classList.toggle("is-done", isRead);
+  }
+  function updateRows() {
+    document.querySelectorAll("[data-read-path]").forEach(function (row) {
+      var rowPath = new URL(row.getAttribute("data-read-path"), window.location.href).pathname;
+      var mark = row.querySelector(".read-check");
+      if (mark) mark.hidden = list.indexOf(rowPath) === -1;
+    });
+  }
+  function updatePersonalProgress() {
+    var relevant = list.filter(function (item) { return /^\/(std|crates|errors)\//.test(item); });
+    document.querySelectorAll("[data-personal-progress]").forEach(function (node) {
+      var prefix = node.getAttribute("data-prefix");
+      var total = Number(node.getAttribute("data-total")) || 0;
+      var count = relevant.filter(function (item) { return item.indexOf(prefix) === 0; }).length;
+      node.textContent = "あなた " + Math.min(count, total) + " / " + total;
+      node.hidden = relevant.length === 0;
+    });
+  }
+  function save() {
+    try { localStorage.setItem(key, JSON.stringify(list)); } catch (e) {}
+    updateRows();
+    updatePersonalProgress();
+  }
+
+  if (finishButton) {
+    finishButton.hidden = false;
+    setReadState(finishButton, list.indexOf(path) !== -1);
+    finishButton.addEventListener("click", function () {
+      var index = list.indexOf(path);
+      if (index === -1) list.push(path);
+      else list.splice(index, 1);
+      setReadState(finishButton, list.indexOf(path) !== -1);
+      save();
+    });
+  }
+  updateRows();
+  updatePersonalProgress();
+})();
+</script>
+<script>
+(function () {
+  var tocLinks = Array.prototype.slice.call(document.querySelectorAll(".toc-link"));
+  var headings = tocLinks.map(function (link) {
+    return document.getElementById(decodeURIComponent(link.hash.slice(1)));
+  }).filter(Boolean);
+  if (!("IntersectionObserver" in window) || !headings.length) return;
+  var observer = new IntersectionObserver(function (entries) {
+    entries.forEach(function (entry) {
+      if (!entry.isIntersecting) return;
+      tocLinks.forEach(function (link) {
+        var active = link.hash.slice(1) === entry.target.id;
+        link.classList.toggle("is-active", active);
+        if (active) link.setAttribute("aria-current", "location");
+        else link.removeAttribute("aria-current");
+      });
+    });
+  }, { rootMargin: "-18% 0px -72% 0px" });
+  headings.forEach(function (heading) { observer.observe(heading); });
+})();
+</script>
 </body>
 </html>
