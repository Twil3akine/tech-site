-
-/* Category block: sections as top bullets, tags in columns below */
-.lp-catlist {
-  margin-bottom: 6px;
-}
-
-.lp-tagcols {
-  columns: 3;
-  column-gap: 28px;
-}
-
-.lp-tagcols li {
-  break-inside: avoid;
-}
-
-/* Tag labels never break mid-word. Wrapping may still occur at spaces,
-   and each list item stays in one column (break-inside: avoid above). */
-.lp-tagcols a {
-  word-break: keep-all;
-}
-
-/* Sidebar blocks: small heading over a soft 1px rule */
-.lp-side-block {
