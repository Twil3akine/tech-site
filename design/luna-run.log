/* Twil3akine (Rust 解説) — light only, plain, content-first (nkmk.me-like).
   Code blocks stay dark panels (Zola night-owl) as a design element. */

:root {
  color-scheme: light;
  --bg: #faf6ef;
  --bg-soft: #fffdf8;
  --border: #e4dccd;
  --border-soft: #efe7d8;
  --text: #1f2433;
  --muted: #5b6275;
  --faint: #77694f;
  --link: #2e4a8c;
  --link-hover: #1e2f5c;
  --accent: #a8502a;
  --inline-code-bg: #f6e6da;
  --inline-code-text: #333333;
  --code-bg: #011627;
  --code-border: #0d2a44;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--text);
  background: var(--bg);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}

/* Shared page geometry: header, content column and landing wrapper
   all use the same centered column with no horizontal padding, so the
   header icon's left edge and the search box's right edge line up
   exactly with the content's left and right edges. */
.container,
.header-inner,
.lp-main,
.lp-footer-inner {
  width: min(760px, 100% - 2.5rem);
  margin: 0 auto;
}

a {
  color: var(--link);
  text-decoration: none;
}

a:hover {
  color: var(--link-hover);
  text-decoration: underline;
}

::selection {
  background: rgba(43, 111, 224, 0.22);
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 4px;
}

/* ---------- Header ---------- */

.site-header {
  border-bottom: 1px solid var(--border);
  background: var(--bg);
}

.header-inner {
  min-height: 56px;
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  padding: 8px 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--text);
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: .02em;
}

.brand:hover {
  text-decoration: none;
  color: var(--text);
}

.brand-icon {
  display: block;
  border-radius: 50%;
}

.site-nav {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-left: auto;
  font-size: 14px;
}

.site-nav a {
  color: var(--muted);
}

.site-nav a:hover {
  color: var(--text);
}

/* Header search: compact, sits quietly after the nav */
.site-search {
  display: flex;
  align-items: stretch;
  flex: 0 1 auto;
}

.site-search-input {
  width: 150px;
  min-width: 0;
  font: inherit;
  font-size: 13.5px;
  padding: 5px 8px;
  border: 1px solid var(--border);
  border-radius: 6px 0 0 6px;
  background: var(--bg);
  color: var(--text);
}

.site-search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  border: 1px solid var(--border);
  border-left: none;
  border-radius: 0 6px 6px 0;
  background: var(--bg-soft);
  color: var(--muted);
  cursor: pointer;
}

.site-search-btn:hover {
  color: var(--text);
}

/* ---------- Landing: grouped lists only ---------- */

.category {
  margin: 26px 0;
}

.category-title {
  font-size: 19px;
  line-height: 1.5;
  margin: 0 0 4px;
}

.category-title a {
  color: var(--text);
}

.category-desc {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 14px;
}

/* Vertical stack of article rows (title only, not cards) */
.stack {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--border);
}

.stack-item {
  padding: 7px 0;
  border-bottom: 1px solid var(--border);
}

.stack-title {
  font-size: 16.5px;
  font-weight: 700;
  line-height: 1.55;
}

.stack-meta {
  margin: 6px 0 0;
  color: var(--faint);
  font-size: 12.5px;
}

.empty {
  color: var(--faint);
  margin: 8px 0;
}

/* ---------- Section & tag pages ---------- */

.section-head {
  margin: 28px 0 6px;
}

.section-title {
  font-size: 24px;
  line-height: 1.4;
  margin: 0;
}

.section-head .category-desc {
  margin-top: 6px;
}

.tag-rows {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--border);
}

.tag-rows li {
  padding: 7px 0;
  border-bottom: 1px solid var(--border);
  display: flex;
  gap: 10px;
  align-items: baseline;
}

.tag-rows .stack-meta {
  margin: 0;
}

/* ---------- Article ---------- */

.article {
  margin: 40px 0 64px;
}

.article h1 {
  font-size: clamp(1.5rem, 1.15rem + 1.5vw, 1.95rem);
  line-height: 1.5;
  font-weight: 800;
  margin: 0;
}


