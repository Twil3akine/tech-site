+  .section-head h1,
+  .article-head h1 {
+    font-size: 30px;
+  }
+
+  .section-lead,
+  .article-lead {
+    font-size: 17px;
+  }
+
+  .article-layout {
+    padding-top: 40px;
+  }
+
+  .article-meta {
+    gap: 8px 12px;
+  }
+
+  .article-body {
+    margin-top: 40px;
+  }
+
+  .article-body h2 {
+    font-size: 24px;
+  }
+
+  .article-body h3 {
+    font-size: 18px;
+  }
+
+  .article-body pre.giallo,
+  .codeblock {
+    width: calc(100% + 40px);
+    margin-right: -20px;
+    margin-left: -20px;
+    border-radius: 0;
+  }
+
+  .article-body pre.giallo {
+    padding: 20px;
+    font-size: 13px;
+  }
+
+  .codeblock pre.giallo {
+    padding: 44px 20px 20px;
+    font-size: 13px;
+  }
+
+  .related-grid {
     grid-template-columns: 1fr;
   }
+
+  .site-footer {
+    padding-top: 40px;
+  }
+
+  .more-sections {
+    flex-direction: column;
+    gap: 10px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+  }
 }
