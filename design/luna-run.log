   header. Unwrapped pre (no JS) still renders as a full panel. */
.article-body pre.giallo {
  font-family: var(--font-mono);
  font-size: 13.5px;
  line-height: 1.75;
  padding: 16px 18px;
  margin: 1.3em 0;
  border: 1px solid var(--code-border);
  border-radius: 8px;
  overflow-x: auto;
}

.codeblock {
  margin: 1.3em 0;
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: 8px;
  overflow: hidden;
}

.codeblock-head {
  display: flex;
  align-items: center;
  height: 34px;
  padding: 0 14px;
  background: rgba(13, 36, 66, 0.6);
  border-bottom: 1px solid rgba(94, 162, 255, 0.14);
}

.codeblock-lang {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #7fd8f7;
}

.codeblock pre.giallo {
  margin: 0;
  border: none;
  border-radius: 0;
}

/* Required by Zola's Giallo highlighter */
.giallo-l {
  display: inline-block;
  min-height: 1lh;
  width: 100%;
}

.giallo-ln {
  display: inline-block;
  user-select: none;
  margin-right: 0.4em;
  padding: 0.4em;
  min-width: 3ch;
  text-align: right;
  opacity: 0.8;
}

/* Dot-prefixed plain lists (related links) */
.dot-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.dot-list li {
  margin: 4px 0;
}

.dot-list li::before {
  content: "・";
  color: var(--faint);
}

.related {
  margin-top: 44px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.related h2 {
  font-size: 16px;
  margin: 0 0 8px;
}

/* Version sentence under the article title: a plain paragraph, no heading or box. */
.version-line {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}

/* ---------- Footer ---------- */

.site-footer {
  margin-top: 64px;
  border-top: 1px solid var(--border);
  padding: 24px 0 32px;
}

.footer-inner {
  display: flex;
  align-items: center;
  gap: 14px 22px;
  flex-wrap: wrap;
}

.footer-brand {
  font-weight: 800;
  font-size: 15px;
}

.footer-nav {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  margin-left: auto;
  font-size: 14px;
}

.footer-nav a {
  color: var(--muted);
}

.footer-nav a:hover {
  color: var(--text);
}

.footer-copy {
  width: 100%;
  margin: 6px 0 0;
  color: var(--faint);
  font-size: 12.5px;
}

/* ---------- Landing (two-column composition) ----------
   Scoped to .lp-* classes; only the top page uses them. The standard
   site header sits on top, then two columns (lists + sidebar); links
   and rules use the same brand-blue / 1px-border treatment as the
   rest of the site. */

.lp-main {
  padding-top: 30px;
}

.lp-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 52px;
  align-items: start;
}

/* Main column blocks: bold heading over our normal 1px rule */
.lp-block {
  margin: 0 0 44px;
}

.lp-h2 {
  font-size: 20px;
  font-weight: 800;
  line-height: 1.5;
  margin: 0 0 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

/* Bulleted lists with our brand-blue links (underline on hover) */
.lp-list {
  list-style: none;
  margin: 0;
  padding: 0;
  line-height: 1.65;
}

.lp-list li {
  margin: 7px 0;
  padding-left: 1.15em;
  text-indent: -1.15em;
}

.lp-list li::before {
  content: "•";
  color: var(--text);
  margin-right: 0.55em;
}

.lp-list a {
  color: var(--link);
  text-decoration: none;
}

.lp-list a:hover {
  color: var(--link-hover);
  text-decoration: underline;
}

/* Category block: sections as top bullets, tags in columns below */
.lp-catlist {
  margin-bottom: 6px;
}

.lp-tagcols {
  columns: 3;
  column-gap: 28px;
}

.lp-tagcols li {
  break-inside: avoid;
}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ config.title }}{% endblock title %}</title>
<meta name="description" content="{% block description %}{{ config.description }}{% endblock description %}">
<link rel="icon" type="image/png" href="{{ get_url(path='favicon.png') }}">
<link rel="apple-touch-icon" href="{{ get_url(path='apple-touch-icon.png') }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ get_url(path='css/style.css') }}">
</head>
<body>
{% block header %}
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="{{ get_url(path='/') }}">
      <img class="brand-icon" src="{{ get_url(path='img/icon.png') }}" alt="" width="30" height="30">
      <span class="brand-name">Twil3akine</span>
    </a>
    <nav class="site-nav">
      <a href="{{ get_url(path='@/std/_index.md') }}">標準ライブラリ</a>
      <a href="{{ get_url(path='@/crates/_index.md') }}">クレート</a>
      <a href="{{ get_url(path='@/errors/_index.md') }}">エラー解決</a>
    </nav>
    <form class="site-search" action="https://www.google.com/search" method="get" role="search" onsubmit="this.q.value = 'site:rust.twil3akine.org ' + this.q.value;">
      <input class="site-search-input" type="text" name="q" autocomplete="off" aria-label="サイト内検索">
      <button class="site-search-btn" type="submit" aria-label="検索">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      </button>
    </form>
  </div>
</header>
{% endblock header %}
<main class="{% block main_class %}container{% endblock main_class %}">
{% block content %}{% endblock content %}
</main>
{% block footer %}
<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-nav">
      <a href="{{ get_url(path='@/privacy.md') }}">プライバシーポリシー</a>
      <a href="https://github.com/Twil3akine">GitHub</a>
    </nav>
    <p class="footer-copy">© 2026 Twil3akine</p>
  </div>
</footer>
{% endblock footer %}
<script>
// Read tracking for the landing page's 読了チェック: article pages record
// their own path in localStorage (nothing leaves the browser).
(function () {
  if (!document.querySelector(".article-body")) return;
  try {
    var key = "rk-read";
    var list = JSON.parse(localStorage.getItem(key) || "[]");
    var path = location.pathname;
    if (list.indexOf(path) === -1) {
      list.push(path);
      localStorage.setItem(key, JSON.stringify(list));
    }
  } catch (e) {}
})();
</script>
<script>
// Give every highlighted code block a panel header with its fence
// language (the language is on the <code data-lang="..."> inside).
(function () {
  document.querySelectorAll("pre.giallo").forEach(function (pre) {
    if (pre.parentElement && pre.parentElement.classList.contains("codeblock")) return;
    var code = pre.querySelector("code");
    var lang = code ? code.getAttribute("data-lang") : null;
    if (lang === "shellsession") lang = "console";
    var wrap = document.createElement("div");
    wrap.className = "codeblock";
    pre.parentNode.insertBefore(wrap, pre);
    if (lang && lang !== "plain") {
      var head = document.createElement("div");
      head.className = "codeblock-head";
      var label = document.createElement("span");
      label.className = "codeblock-lang";
      label.textContent = lang;
      head.appendChild(label);
      wrap.appendChild(head);
    }
    wrap.appendChild(pre);
  });
})();
</script>
</body>
</html>

