+            <span class="article-row-title"><span class="read-check" hidden aria-label="攻略済み">✓</span>{{ parts[2] }}</span>
+            <span class="article-row-description">{{ parts[5] }}</span>
+          </span>
+          <span class="article-row-meta">{{ parts[0] }}</span>
+        </a>
+        {% set_global latest_shown = latest_shown + 1 %}
+      {% endif %}
+    {% endfor %}
+  </div>
+  {% if total > 8 %}
+  <nav class="more-sections" aria-label="記事一覧">
+    <a href="{{ std.permalink | safe }}">標準ライブラリの記事</a>
+    <a href="{{ crates.permalink | safe }}">クレートの記事</a>
+    <a href="{{ errors.permalink | safe }}">エラー解決の記事</a>
+  </nav>
+  {% endif %}
+</section>
 {% endblock content %}
