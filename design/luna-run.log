+    padding: 56px 0 40px;
+  }
+
+  .hero-copy h1 {
+    font-size: 36px;
+    line-height: 1.15;
+  }
+
+  .hero-lead {
+    margin-top: 16px;
+    font-size: 17px;
+  }
+
+  .hero-actions {
+    align-items: stretch;
+    flex-direction: column;
+    gap: 12px;
+    margin-top: 32px;
+  }
+
+  .button {
+    min-height: 48px;
+  }
+
+  .home-section {
+    margin-top: 64px;
+  }
+
+  .home-section:last-child {
+    margin-bottom: 64px;
+  }
+
+  .section-heading-row {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 4px;
+    margin-bottom: 20px;
+  }
+
+  .section-heading-row h2,
+  .planned-section h2 {
+    font-size: 24px;
+  }
+
+  .map-card {
+    padding: 24px;
+  }
+
+  .map-description {
+    min-height: 0;
+  }
+
+  .article-list-item {
+    align-items: flex-start;
+  }
+
+  .route-number {
+    margin-top: 26px;
+  }
+
+  .article-row {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 4px;
+  }
+
+  .article-row-title {
+    font-size: 16px;
+  }
+
+  .article-row-meta {
+    margin-top: 4px;
+  }
+
+  .section-page {
+    padding-top: 40px;
+  }
+
+  .section-title,
+  .section-head h1,
+  .article-head h1 {
+    font-size: 30px;
+  }
+
+  .section-lead,
+  .article-lead {
+    font-size: 17px;
+  }
+
+  .article-layout {
+    padding-top: 40px;
+  }
+
+  .article-meta {
+    gap: 8px 12px;
+  }
+
+  .article-body {
+    margin-top: 40px;
+  }
+
+  .article-body h2 {
+    font-size: 24px;
+  }
+
+  .article-body h3 {
+    font-size: 18px;
+  }
+
+  .article-body > pre.giallo,
+  .article-body > .codeblock {
+    width: calc(100% + 40px);
+    margin-right: -20px;
+    margin-left: -20px;
+    border-radius: 0;
+  }
+
+  .article-body pre.giallo {
+    padding: 20px;
+    font-size: 13px;
+  }
+
+  .codeblock pre.giallo {
+    padding: 44px 20px 20px;
+    font-size: 13px;
+  }
+
+  .related-grid {
     grid-template-columns: 1fr;
   }
+
+  .site-footer {
+    padding-top: 40px;
+  }
+
+  .more-sections {
+    flex-direction: column;
+    gap: 10px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+  }
 }
