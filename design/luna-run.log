base_url = "https://rust.twil3akine.org"
title = "Twil3akine"
description = "Rust の標準ライブラリ、主要クレート、エラー解決。"
default_language = "ja"

# 検索インデックスは当面オフ（記事が増えたら有効化を検討）
build_search_index = false
generate_sitemap = true
compile_sass = false

[[taxonomies]]
name = "tags"

[markdown.highlighting]
style = "inline"
theme = "night-owl"
{% extends "base.html" %}

{# Landing: original "Rust 攻略ノート" design (concept and specs by
   Claude Sonnet, integrated by Alis — see design/sonnet-design.md).
   Hero with grid-paper background and avatar, STAGE cards for the three
   sections, latest-article rows with difficulty dots and read checks,
   and a sidebar (はじめての人へ / 読了チェック / タグ). Book reviews
   stay off this page by policy: direct URL only. #}
{% block main_class %}rk-wrap{% endblock main_class %}

{% block content %}
{% set std = get_section(path="std/_index.md") %}
{% set crates = get_section(path="crates/_index.md") %}
{% set errors = get_section(path="errors/_index.md") %}
{% set sections = [std, crates, errors] %}
{% set tags = get_taxonomy(kind="tags") %}
{% set_global allowed_tags_str = "@@" %}
{% for sec in sections %}
  {% for page in sec.pages %}
    {% if page.taxonomies.tags %}{% for t in page.taxonomies.tags %}{% set_global allowed_tags_str = allowed_tags_str ~ t ~ "@@" %}{% endfor %}{% endif %}
  {% endfor %}
{% endfor %}
{% set allowed_tags = allowed_tags_str | split(pat="@@") %}
{% set total = std.pages | length + crates.pages | length + errors.pages | length %}
{# entry fields: date @@ permalink @@ title @@ section-slug @@ level @@ section-title #}
{% set_global latest_str = "" %}
{% for sec in sections %}
  {% set slug = sec.path | split(pat="/") | nth(n=1) %}
  {% for page in sec.pages %}
    {% if page.date %}{% set_global latest_str = latest_str ~ page.date ~ "@@" ~ page.permalink ~ "@@" ~ page.title ~ "@@" ~ slug ~ "@@" ~ page.extra.level ~ "@@" ~ sec.title ~ ";;" %}{% endif %}
  {% endfor %}
{% endfor %}
{% set entries = latest_str | split(pat=";;") | sort | reverse %}
{% set first = get_page(path="std/hashmap.md") %}
{% set second = get_page(path="std/iterator.md") %}
{% set third = get_page(path="std/file-io.md") %}

<section class="rk-hero">
  <div class="rk-hero-text">
    <p class="rk-hero-label">RUST 攻略ノート</p>
    <h1 class="rk-hero-title">Rust を、ひとつずつ攻略する。</h1>
    <p class="rk-hero-lead">標準ライブラリ、よく使うクレート、つまずくエラー。テーマごとに1記事で、動くコードと一緒に確認します。完全攻略を目指して更新中・現在 {{ total }} 記事。</p>
    <div class="rk-hero-actions">
      <a class="rk-btn rk-btn-primary" href="{{ first.permalink | safe }}">最初に読む</a>
      <a class="rk-btn rk-btn-ghost" href="{{ errors.permalink | safe }}">エラーから探す</a>
    </div>
  </div>
  <div class="rk-hero-avatar" aria-hidden="true">
    <div class="rk-bubble">迷ったらここから！</div>
    <img src="{{ get_url(path='img/icon.png') }}" alt="" width="160" height="160">
  </div>
</section>

<section class="rk-stages">
  {% for sec in sections %}
  {% set slug = sec.path | split(pat="/") | nth(n=1) %}
  <a class="rk-stage rk-stage-{{ slug }}" href="{{ sec.permalink | safe }}">
    <span class="rk-stage-no">STAGE 0{{ loop.index }}</span>
    <span class="rk-stage-name">{{ sec.title }}</span>
    <span class="rk-stage-desc">{{ sec.description }}</span>
    <span class="rk-stage-count">{{ sec.pages | length }} 記事</span>
  </a>
  {% endfor %}
</section>

<div class="rk-grid">
  <div class="rk-col">
    <section>
      <h2 class="rk-h2">新着記事</h2>
      <div class="rk-rows">
        {% set_global shown = 0 %}
        {% for e in entries %}
        {% if e and shown < 10 %}
        {% set parts = e | split(pat="@@") %}
        <a class="rk-row" href="{{ parts[1] }}" data-path="{{ parts[1] }}">
          <span class="rk-dots" aria-label="難易度 {{ parts[4] }}">{% if parts[4] == "1" %}●○○{% elif parts[4] == "2" %}●●○{% else %}●●●{% endif %}</span>
          <span class="rk-row-main">
            <span class="rk-row-title">{{ parts[2] }}</span>
            <span class="rk-row-meta">
              <span class="rk-chip rk-chip-{{ parts[3] }}">{{ parts[5] }}</span>
              <span class="rk-date">{{ parts[0] }}</span>
              <span class="rk-check" hidden>✓ 読了</span>
            </span>
          </span>
        </a>
        {% set_global shown = shown + 1 %}
        {% endif %}
        {% endfor %}
      </div>
      <p class="rk-more"><a href="{{ get_url(path='@/all/_index.md') }}">すべての記事を見る</a></p>
    </section>
  </div>

  <aside class="rk-side">
    <section class="rk-card">
      <h2 class="rk-card-h">はじめての人へ</h2>
      <ol class="rk-rec">
        <li><a href="{{ first.permalink | safe }}">{{ first.title }}</a></li>
        <li><a href="{{ second.permalink | safe }}">{{ second.title }}</a></li>
        <li><a href="{{ third.permalink | safe }}">{{ third.title }}</a></li>
      </ol>
    </section>

    <section class="rk-card">
      <h2 class="rk-card-h">読了チェック</h2>
      <p class="rk-progress-text"><span id="rk-read-count">0</span> / {{ total }} 記事</p>
      <div class="rk-progress"><div class="rk-progress-fill" id="rk-progress-fill"></div></div>
      <p class="rk-progress-note">読んだ記事はこのブラウザに記録されます。</p>
    </section>

    <section class="rk-card">
      <h2 class="rk-card-h">タグ</h2>
      <div class="rk-tags">
        {% set_global tag_shown = 0 %}
        {% for term in tags.items %}
        {% if term.name in allowed_tags and tag_shown < 12 %}<a class="rk-tag" href="{{ term.permalink | safe }}">#{{ term.name }}</a>{% set_global tag_shown = tag_shown + 1 %}{% endif %}
        {% endfor %}
      </div>
    </section>
  </aside>
</div>

<script>
(function () {
  var list = [];
  try { list = JSON.parse(localStorage.getItem("rk-read") || "[]"); } catch (e) {}
  var read = 0;
  document.querySelectorAll(".rk-row").forEach(function (row) {
    var path = new URL(row.getAttribute("href"), location.href).pathname;
    if (list.indexOf(path) !== -1) {
      row.querySelector(".rk-check").hidden = false;
    }
  });
  // Count read articles against the site total (paths under the sections).
  list.forEach(function (p) {
    if (/^\/(std|crates|errors)\//.test(p)) read++;
  });
  var total = {{ total }};
  var count = document.getElementById("rk-read-count");
  if (count) count.textContent = Math.min(read, total);
  var fill = document.getElementById("rk-progress-fill");
  if (fill && total > 0) fill.style.width = Math.min(100, Math.round(read / total * 100)) + "%";
})();
</script>
{% endblock content %}

@media (max-width: 900px) {
  .lp-grid {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .lp-tagcols {
    columns: 2;
  }
}

/* ---------- Small screens ---------- */

@media (max-width: 640px) {
  .site-nav {
    gap: 12px;
    font-size: 13.5px;
  }

  /* Header search wraps to its own full-width row */
  .site-search {
    flex: 1 1 100%;
  }

  .site-search-input {
    flex: 1;
    width: auto;
  }

  .section-title {
    font-size: 21px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  * {
    transition: none !important;
  }
}

/* Headings use Zen Kaku Gothic New across the site (design spec). */
.article h1,
.article-body > h2,
.article-body > h3,
.section-head h1 {
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  letter-spacing: .02em;
  font-feature-settings: "palt";
}

/* Landing page: "Rust 攻略ノート" design (Sonnet spec, design/sonnet-design.md).
   Paper background, stage cards, difficulty dots, read checks. */

.rk-wrap {
  max-width: 1040px;
  margin: 0 auto;
  padding: 0 24px;
}

.rk-hero {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 32px;
  padding: 56px 8px 40px;
  background-image:
    linear-gradient(to right, #efe7d8 1px, transparent 1px),
    linear-gradient(to bottom, #efe7d8 1px, transparent 1px);
  background-size: 24px 24px;
}

.rk-hero-label {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  color: var(--accent);
}

.rk-hero-title {
  margin: 0 0 14px;
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  font-size: 40px;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: .02em;
  font-feature-settings: "palt";
}

.rk-hero-lead {
  margin: 0 0 24px;
  max-width: 34em;
  font-size: 16px;
  line-height: 1.85;
  color: var(--text);
}

.rk-hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.rk-btn {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 12px 20px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
}

.rk-btn:hover {
  text-decoration: none;
}

.rk-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.rk-btn-primary {
  background: var(--link);
  color: #fff;
}

.rk-btn-primary:hover {
  background: var(--link-hover);
  color: #fff;
}

.rk-btn-ghost {
  border: 1px solid var(--link);
  color: var(--link);
  background: transparent;
}

.rk-btn-ghost:hover {
  background: #eef1f8;
  color: var(--link);
}

.rk-hero-avatar {
  position: relative;
  flex: 0 0 auto;
  align-self: flex-start;
}

.rk-hero-avatar img {
  display: block;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 3px 3px 0 var(--border);
}

.rk-bubble {
  position: absolute;
  top: -14px;
  right: 128px;
  width: max-content;
  max-width: 180px;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
}

.rk-bubble::after {
  content: "";
  position: absolute;
  top: 60%;
  right: -6px;
  width: 10px;
  height: 10px;
  background: #fff;
  border-top: 1px solid var(--border);
  border-right: 1px solid var(--border);
  transform: rotate(45deg);
}

.rk-stages {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 8px 0 40px;
}

.rk-stage {
  display: block;
  background: #fff;
  border: 1px solid var(--border);
  border-top: 4px solid var(--link);
  border-radius: 6px;
  padding: 20px;
  color: var(--text);
  transition: transform .15s, box-shadow .15s;
}

.rk-stage:hover {
  text-decoration: none;
  color: var(--text);
  transform: translateY(-2px);
  box-shadow: 3px 3px 0 var(--border);
}

.rk-stage-crates {
  border-top-color: #2f7d6b;
}

.rk-stage-errors {
  border-top-color: #c2412d;
}

.rk-stage-no {
  display: block;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 12px;
  letter-spacing: .1em;
  color: var(--muted);
  margin-bottom: 6px;
}

.rk-stage-name {
  display: block;
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 6px;
}

.rk-stage-desc {
  display: block;
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--muted);
  margin-bottom: 10px;
}

.rk-stage-count {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
}

.rk-grid {
  display: grid;
  grid-template-columns: 1fr 256px;
  gap: 40px;
  align-items: start;
  padding-bottom: 48px;
}

.rk-h2 {
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;
  margin: 0 0 8px;
  letter-spacing: .02em;
}

.rk-rows {
  border-top: 1px solid var(--border);
}

.rk-row {
  display: flex;
  gap: 12px;
  align-items: baseline;
  padding: 16px 8px;
  border-bottom: 1px solid var(--border);
  border-left: 3px solid transparent;
  color: var(--text);
  transition: background .15s;
}

.rk-row:hover {
  text-decoration: none;
  color: var(--text);
  background: #fff;
}

.rk-dots {
  flex: 0 0 auto;
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--accent);
  white-space: nowrap;
}

.rk-row-main {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.rk-row-title {
  font-size: 17px;
  font-weight: 700;
  line-height: 1.5;
}

.rk-row:hover .rk-row-title {
  text-decoration: underline;
  text-decoration-color: var(--accent);
  text-decoration-thickness: 2px;
  text-underline-offset: 4px;
}

.rk-row-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.rk-chip {
  font-size: 12px;
  padding: 2px 8px;
  border: 1px solid var(--link);
  border-radius: 4px;
  color: var(--link);
  line-height: 1.5;
}

.rk-chip-crates {
  border-color: #2f7d6b;
  color: #2f7d6b;
}

.rk-chip-errors {
  border-color: #c2412d;
  color: #c2412d;
}

.rk-date {
  font-size: 13px;
  color: var(--muted);
}

.rk-check {
  font-size: 13px;
  font-weight: 700;
  color: #2f7d6b;
}

.rk-more {
  margin: 16px 0 0;
  font-size: 14px;
}

.rk-side {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.rk-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 18px;
}

.rk-card-h {
  font-family: "Zen Kaku Gothic New", var(--font-sans);
  font-size: 15px;
  font-weight: 700;
  margin: 0 0 12px;
  letter-spacing: .02em;
}

.rk-rec {
  margin: 0;
  padding-left: 1.5em;
  font-size: 14px;
  line-height: 1.7;
}

.rk-rec li {
  margin-bottom: 8px;
}

.rk-rec li::marker {
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-weight: 700;
  color: var(--accent);
}

.rk-progress-text {
  margin: 0 0 8px;
  font-size: 14px;
  font-weight: 700;
}

.rk-progress {
  height: 6px;
  border-radius: 3px;
  background: var(--border);
  overflow: hidden;
}

.rk-progress-fill {
  height: 100%;
  width: 0;
  background: var(--accent);
  border-radius: 3px;
  transition: width .3s;
}

.rk-progress-note {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.6;
}

.rk-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.rk-tag {
  font-size: 12px;
  padding: 2px 8px;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--muted);
  line-height: 1.6;
}

.rk-tag:hover {
  text-decoration: none;
  background: #f6e6da;
  border-color: #dea584;
  color: var(--text);
}

@media (max-width: 959px) {
  .rk-grid {
    grid-template-columns: 1fr;
  }

  .rk-side {
    flex-direction: column;
  }
}

@media (max-width: 720px) {
  .rk-wrap {
    padding: 0 16px;
  }

  .rk-hero {
    padding: 40px 4px 32px;
  }

  .rk-hero-title {
    font-size: 28px;
  }

  .rk-hero-avatar {
    display: none;
  }

  .rk-stages {
    grid-template-columns: 1fr;
  }
}

